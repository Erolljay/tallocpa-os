# Copy this file to `.env` and fill in real values. `.env` is gitignored — never
# commit real keys.

# Supabase — create a project at https://supabase.com
# Region: Southeast Asia (Singapore) — closest to the Philippines.
# Find these under: Project Settings -> API

# Project URL (looks like https://abcdefgh.supabase.co)
SUPABASE_URL=

# service_role secret key — SERVER-SIDE ONLY. Powerful (bypasses RLS).
# Never expose in a browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
