# Copy this file to `.env` and fill in real values. `.env` is gitignored — never
# commit real keys.

# Supabase — create a project at https://supabase.com
# Region: Southeast Asia (Singapore) — closest to the Philippines.
# Find these under: Project Settings -> API

# Project URL (looks like https://abcdefgh.supabase.co)
SUPABASE_URL=

# service_role secret key — SERVER-SIDE ONLY. Powerful (bypasses RLS).
# Never expose in a browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Publishable key (or the legacy "anon" key) — safe for the browser; RLS applies.
# Used by the client portal (apps/portal) for sign-in and direct file uploads.
SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Client portal -> n8n hand-off (apps/portal)
# ---------------------------------------------------------------------------

# Where the portal runs (used in invite emails). e.g. http://localhost:3000
PORTAL_URL=

# Production URL of the n8n Webhook node that receives approved documents.
N8N_WEBHOOK_URL=

# Shared secret sent as the `x-tallocpa-secret` header; configure the same value
# in the n8n Webhook node's Header Auth credential. Long random string.
N8N_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Telegram invoice bot (apps/telegram-invoice-bot)
# ---------------------------------------------------------------------------

# Bot token from @BotFather on Telegram (https://t.me/BotFather -> /newbot).
TELEGRAM_BOT_TOKEN=

# Google Gemini API key (https://aistudio.google.com/apikey). Used for vision
# extraction of the invoice fields. SERVER-SIDE ONLY, never commit.
GEMINI_API_KEY=

# Optional — Gemini model id. Defaults to gemini-2.0-flash when unset.
GEMINI_MODEL=

# Optional — Supabase Storage bucket for receipt images. Defaults to "receipts"
# (created by supabase/migrations/0004_receipts_bucket.sql).
SUPABASE_RECEIPTS_BUCKET=
