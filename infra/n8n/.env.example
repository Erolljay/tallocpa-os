# Copied to .env by setup.sh, with the secrets generated for you.
# Keep .env on the server only; back up N8N_ENCRYPTION_KEY somewhere safe.

N8N_DOMAIN=n8n.tallocpa.com

# Where the client portal runs; the workflows call its /api/n8n/* endpoints.
PORTAL_URL=https://portal.tallocpa.com

# Pin a version (e.g. 1.x.y) for repeatable restarts; "stable" follows n8n's stable channel.
N8N_VERSION=stable

N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=
